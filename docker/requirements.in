# Runtime Python tooling installed into the Docker image (see Dockerfile).
# Edit this file, then regenerate the hash-pinned lockfile (requirements.txt):
#   docker run --rm -v "$PWD/docker:/w" -w /w python:3.13-slim-trixie sh -c \
#     'pip install -q pip-tools==7.6.2 && pip-compile --generate-hashes --allow-unsafe --strip-extras requirements.in'
# Renovate (pip-compile manager) updates both files as fix(deps) commits, which land in the next
# release PR as a patch bump; the image is rebuilt when that release is cut.
# The "default" extra pulls yt-dlp-ejs (YouTube JS challenge solver) plus the recommended
# optional dependencies (brotli, certifi, mutagen, pycryptodomex, websockets...).
yt-dlp[default]==2026.8.19
