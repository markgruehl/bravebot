{
  "name": "bravebot",
  "version": "2.0.0",
  "private": true,
  "description": "Discord bot: soundboard (attachments, URLs via yt-dlp, saved library) plus voice activity notices",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "@snazzah/davey": "0.1.12",
    "discord.js": "14.27.0"
  },
  "overrides": {
    "@discordjs/node-pre-gyp": {
      "tar": "7.5.22"
    }
  }
}
