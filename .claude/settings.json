{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git worktree list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(gh pr merge*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(docker push*)",
      "Bash(* docker push*)",
      "Bash(docker image push*)",
      "Bash(docker compose push*)",
      "Bash(docker buildx * --push*)"
    ]
  }
}
